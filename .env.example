# Copy to .env for local development. Never commit real secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://ledgerguard.example.ng
# Set to False only for local HTTP development
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0
DATABASE_URL=postgres://ledgerguard:CHANGE_ME@localhost:5432/ledgerguard
CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
LEDGERGUARD_MEDIA_ROOT=/var/lib/ledgerguard/media
LEDGERGUARD_MAX_UPLOAD_MB=25
LEDGERGUARD_LOGIN_MAX_FAILURES=5
LEDGERGUARD_LOGIN_LOCKOUT_SECONDS=900
LEDGERGUARD_SESSION_AGE_SECONDS=1800
LOG_LEVEL=INFO
