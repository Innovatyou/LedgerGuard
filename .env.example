# Copy to .env and fill in. Never commit real secrets; in production inject these from a vault.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ledgerguard.example.ng
DJANGO_CSRF_TRUSTED_ORIGINS=https://ledgerguard.example.ng
DJANGO_SECURE_COOKIES=True          # False only for local HTTP development
DJANGO_SECURE_SSL_REDIRECT=True     # once HTTPS is in place
DJANGO_HSTS_SECONDS=31536000        # once HTTPS is verified

# Application role (data access only) and owner role (migrations) – see deploy/postgres/create_roles.sql
DATABASE_URL=postgres://ledgerguard_app:CHANGE_ME@db-host:5432/ledgerguard
MIGRATION_DATABASE_URL=postgres://ledgerguard_owner:CHANGE_ME@db-host:5432/ledgerguard
APP_DB_ROLE=ledgerguard_app

CACHE_URL=redis://redis-host:6379/1
CELERY_BROKER_URL=redis://redis-host:6379/0
CELERY_TASK_ALWAYS_EAGER=False

LEDGERGUARD_MEDIA_ROOT=/var/lib/ledgerguard/media
LEDGERGUARD_BACKUP_DIR=/var/lib/ledgerguard/backups
LEDGERGUARD_BACKUP_RETENTION_DAYS=35
LEDGERGUARD_INGEST_ROOT=/var/lib/ledgerguard/ingest
LEDGERGUARD_MAX_UPLOAD_MB=25
LEDGERGUARD_LOGIN_MAX_FAILURES=5
LEDGERGUARD_LOGIN_LOCKOUT_SECONDS=900
LEDGERGUARD_SESSION_AGE_SECONDS=1800
LOG_LEVEL=INFO

# Docker compose only
POSTGRES_PASSWORD=CHANGE_ME
LEDGERGUARD_OWNER_PASSWORD=CHANGE_ME
LEDGERGUARD_APP_PASSWORD=CHANGE_ME
